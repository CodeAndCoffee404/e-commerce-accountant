# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit the filled-in file.
# See docs/SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# Neon Postgres, injected by the Vercel marketplace integration.
#   ea-prod -> Production,             no prefix  -> DATABASE_URL
#   ea-dev  -> Preview + Development,  DEV_ prefix -> DEV_DATABASE_URL
# The app reads whichever of the two is present. Locally, set either one.
# Use the POOLED string (host contains "-pooler"); the _UNPOOLED variant is
# picked up automatically for migrations when present.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED=""

# Auth.js session signing key.  Generate: npx auth secret
AUTH_SECRET=""

# Public origin Auth.js builds the OAuth redirect_uri from. Pinned because a
# preview deployment would otherwise use its own unique hostname, which Google
# has not been told about.
AUTH_URL="http://localhost:3000"

# Comma-separated Google accounts allowed in while the allowlist table is empty.
# The first such sign-in creates the default tenant and becomes its owner.
AUTH_BOOTSTRAP_EMAILS=""

# Google OAuth client, used both for sign-in and for the Drive connection.
# Google Cloud Console -> Credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Browser key for Google's folder picker. Travels to the client by design and
# is restricted by referrer and by API in the console, so it is not a secret in
# the usual sense. Without it the folder chooser cannot open.
GOOGLE_PICKER_API_KEY=""

# Encryption key for secrets at rest (Google refresh tokens).
# Generate: npm run generate:key      -> 64 hex characters
ENCRYPTION_KEY=""

# Blob storage needs no key here: the project authenticates by OIDC.
# `npx vercel env pull .env.local` brings VERCEL_OIDC_TOKEN and BLOB_STORE_ID,
# which is all the SDK needs. The OIDC token expires — pull again if writes
# start failing with an auth error.

# Shared secret for the daily scheduler at /api/cron/daily. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` on every cron invocation; the route
# refuses everything else, and refuses everything when this is unset.
# Generate: npm run generate:key
CRON_SECRET=""
