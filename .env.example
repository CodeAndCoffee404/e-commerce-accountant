# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit the filled-in file.
# See docs/SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# Neon Postgres, injected by the Vercel marketplace integration.
#   ea-prod -> Production,             no prefix  -> DATABASE_URL
#   ea-dev  -> Preview + Development,  DEV_ prefix -> DEV_DATABASE_URL
# The app reads whichever of the two is present. Locally, set either one.
# Use the POOLED string (host contains "-pooler"); the _UNPOOLED variant is
# picked up automatically for migrations when present.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED=""

# Auth.js session signing key.  Generate: npx auth secret
AUTH_SECRET=""

# Google OAuth client (sign-in).  Google Cloud Console -> Credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encryption key for secrets at rest (Google refresh tokens).
# Generate: npm run generate:key      -> 64 hex characters
ENCRYPTION_KEY=""

# Vercel Blob store token.  Vercel -> Storage -> Blob -> connect to project.
BLOB_READ_WRITE_TOKEN=""
